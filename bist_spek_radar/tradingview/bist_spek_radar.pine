//@version=6
indicator("BIST Spek Radar • Erken AL / SAT", shorttitle="BIST Spek Radar", overlay=true, max_labels_count=500)

// ── Kullanıcı ayarları
minScore = input.int(65, "AL için minimum puan", minval=40, maxval=95)
volLen = input.int(20, "Hacim baz periyodu", minval=10)
cooldown = input.int(5, "Sinyaller arası bar", minval=1)
showPanel = input.bool(true, "Radar panelini göster")
showLabels = input.bool(true, "AL / SAT etiketlerini göster")
avoidExtended = input.bool(true, "Aşırı yükselmiş hissede AL verme")

// ── Temel göstergeler
ema9 = ta.ema(close, 9)
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
rsi = ta.rsi(close, 14)
atr = ta.atr(14)
volBase = ta.sma(volume, volLen)
volRatio = volBase > 0 ? volume / volBase : 0.0
volAccel = ta.sma(volume, 5) / math.max(ta.sma(volume, volLen)[5], 1)
obv = ta.cum(math.sign(ta.change(close)) * volume)
obvEma = ta.ema(obv, 8)
[macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)
rangeHigh = ta.highest(high, 20)[1]
rangeLow = ta.lowest(low, 20)[1]
rangePos = rangeHigh > rangeLow ? (close - rangeLow) / (rangeHigh - rangeLow) : 0.5
ret1 = 100 * (close / close[1] - 1)
ret5 = 100 * (close / close[5] - 1)
ret20 = 100 * (close / close[20] - 1)

// ── 100 puanlık erken hareket skoru
score = 0
score += volAccel >= 2.0 ? 25 : volAccel >= 1.5 ? 18 : volAccel >= 1.25 ? 10 : 0
score += volRatio >= 2.0 ? 20 : volRatio >= 1.5 ? 14 : volRatio >= 1.2 ? 7 : 0
score += ret1 >= -3 and ret1 <= 4 ? 10 : 0
score += ret5 >= -5 and ret5 <= 12 ? 15 : ret5 > -8 and ret5 <= 16 ? 8 : 0
score += ret20 <= 20 ? 10 : ret20 <= 30 ? 5 : 0
score += rangePos >= 0.35 and rangePos <= 0.90 ? 10 : 0
score += ema9 >= ema21 and ema9 > ema9[3] ? 10 : 0
score += rsi >= 48 and rsi <= 70 ? 5 : 0
score += obv > obvEma ? 5 : 0
score := math.min(score, 100)

// ── Sinyaller: bar kapanışında kesinleşir
extended = ret1 >= 8 or ret5 > 18 or ret20 > 30
trendOk = ema9 >= ema21 and ema9 > ema9[3]
volumeOk = volRatio >= 1.2 and volAccel >= 1.15
momentumOk = rsi >= 48 and rsi <= 72 and macdHist >= macdHist[1]
var int lastBuyBar = na
buySetup = score >= minScore and trendOk and volumeOk and momentumOk and (not avoidExtended or not extended)
buySignal = barstate.isconfirmed and buySetup and (na(lastBuyBar) or bar_index - lastBuyBar >= cooldown)
if buySignal
    lastBuyBar := bar_index

// SAT / risk: trend bozulması veya momentum-hacim dağılımı işaretleri
lossOfTrend = ta.crossunder(ema9, ema21)
momentumFade = rsi < 48 and macdHist < macdHist[1]
distributionRisk = volRatio >= 1.5 and close < open and close < close[1]
sellSignal = barstate.isconfirmed and (lossOfTrend or (momentumFade and distributionRisk) or (rsi > 78 and ta.crossunder(rsi, 78)))

plot(ema9, "EMA 9", color=color.new(color.lime, 0), linewidth=2)
plot(ema21, "EMA 21", color=color.new(color.orange, 0), linewidth=2)
plot(ema50, "EMA 50", color=color.new(color.blue, 35), linewidth=1)
plotshape(buySignal, title="AL", text="AL", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), textcolor=color.black, size=size.small)
plotshape(sellSignal, title="SAT / RİSK", text="SAT", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
bgcolor(buySetup and not buySignal ? color.new(color.green, 90) : na, title="Hazırlık bölgesi")

if showLabels and buySignal
    label.new(bar_index, low - atr * 0.25, "ERKEN AL\nPuan: " + str.tostring(score) + "\nHacim: " + str.tostring(volRatio, "#.##") + "x", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white)
if showLabels and sellSignal
    label.new(bar_index, high + atr * 0.25, "SAT / RİSK\nRSI: " + str.tostring(rsi, "#"), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)

// ── Radar bilgi paneli
var table panel = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast and showPanel
    status = buySignal ? "AL SİNYALİ" : buySetup ? "HAZIRLIK" : sellSignal ? "SAT / RİSK" : "İZLE"
    statusColor = buySignal ? color.lime : buySetup ? color.orange : sellSignal ? color.red : color.gray
    table.cell(panel, 0, 0, "BIST SPEK RADAR", bgcolor=color.black, text_color=color.white)
    table.cell(panel, 1, 0, syminfo.ticker, bgcolor=color.black, text_color=color.white)
    table.cell(panel, 0, 1, "Sinyal")
    table.cell(panel, 1, 1, status, text_color=statusColor)
    table.cell(panel, 0, 2, "Skor")
    table.cell(panel, 1, 2, str.tostring(score) + " / 100")
    table.cell(panel, 0, 3, "Hacim / Ort.")
    table.cell(panel, 1, 3, str.tostring(volRatio, "#.##") + "x")
    table.cell(panel, 0, 4, "Hacim ivmesi")
    table.cell(panel, 1, 4, str.tostring(volAccel, "#.##") + "x")
    table.cell(panel, 0, 5, "RSI / 5g")
    table.cell(panel, 1, 5, str.tostring(rsi, "#") + " / " + str.tostring(ret5, "#.##") + "%")

alertcondition(buySignal, title="BIST Spek Radar AL", message="BIST SPEK RADAR AL | {{ticker}} | {{interval}} | Kapanış: {{close}}")
alertcondition(sellSignal, title="BIST Spek Radar SAT/RİSK", message="BIST SPEK RADAR SAT/RİSK | {{ticker}} | {{interval}} | Kapanış: {{close}}")
alertcondition(buySetup and not buySignal, title="BIST Spek Radar HAZIRLIK", message="BIST SPEK RADAR HAZIRLIK | {{ticker}} | {{interval}} | Kapanış: {{close}}")
