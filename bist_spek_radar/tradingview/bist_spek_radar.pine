//@version=6
indicator("BIST Spek Radar - Sade", shorttitle="SPEK RADAR", overlay=true, max_labels_count=100)

// Ayarlar
breakoutLen = input.int(20, "Kirilim periyodu", minval=10, maxval=60)
volumeFactor = input.float(1.5, "Kirilimda hacim katsayisi", minval=1.1, maxval=4.0, step=0.1)
showEma = input.bool(true, "EMA 21'i goster")

// Trend ve para akisi
ema21 = ta.ema(close, 21)
ema50 = ta.ema(close, 50)
barRange = math.max(high - low, syminfo.mintick)
mfMultiplier = ((close - low) - (high - close)) / barRange
mfVolume = mfMultiplier * volume
cmf = ta.sma(mfVolume, 20) / math.max(ta.sma(volume, 20), 1)

// Hacim ve OBV birikimi
volAvg = ta.sma(volume, 20)
volRatio = volAvg > 0 ? volume / volAvg : 0.0
obv = ta.cum(close > close[1] ? volume : close < close[1] ? -volume : 0)
obvBase = ta.ema(obv, 21)
obvRising = obv > obvBase and obvBase > obvBase[3]

// Daralma: Bollinger bant genisligi son 100 barin dip bolgesinde
basis = ta.sma(close, 20)
dev = 2.0 * ta.stdev(close, 20)
bbWidth = basis != 0 ? (2.0 * dev) / basis : na
lowestWidth = ta.lowest(bbWidth, 100)
squeeze = not na(lowestWidth) and bbWidth <= lowestWidth * 1.35

// Hazirlik: daralma + pozitif para akisi + birikim + yukari egimli kisa trend
trendUp = close > ema21 and ema21 > ema21[3]
prepPoints = (squeeze ? 1 : 0) + (cmf > 0.03 ? 1 : 0) + (obvRising ? 1 : 0) + (trendUp ? 1 : 0)
preparation = prepPoints >= 3

// Kirilim: onceki breakoutLen barin tepesinin kapanisla asilmasi
priorHigh = ta.highest(high, breakoutLen)[1]
rsi = ta.rsi(close, 14)
notChasing = close < ema21 * 1.10 and close < close[1] * 1.08
breakout = ta.crossover(close, priorHigh)
rawBuy = breakout and volRatio >= volumeFactor and cmf > 0.03 and close > ema21 and rsi >= 50 and rsi <= 76 and notChasing

// Tek AL ve tek SAT: sinyalden sonra yeni AL icin SAT kosulu beklenir
var bool inTrade = false
buySignal = barstate.isconfirmed and rawBuy and not inTrade
sellCondition = ta.crossunder(close, ema21) or (ta.crossunder(ta.ema(close, 9), ema21) and cmf < 0)
sellSignal = barstate.isconfirmed and inTrade and sellCondition

if buySignal
    inTrade := true
else if sellSignal
    inTrade := false

prepSignal = barstate.isconfirmed and preparation and not preparation[1] and not inTrade

plot(showEma ? ema21 : na, "EMA 21", color=color.orange, linewidth=2)
plotshape(prepSignal, title="HAZIRLIK", text="HAZIR", style=shape.labelup, location=location.belowbar, color=color.yellow, textcolor=color.black, size=size.tiny)
plotshape(buySignal, title="AL", text="AL", style=shape.labelup, location=location.belowbar, color=color.lime, textcolor=color.black, size=size.small)
plotshape(sellSignal, title="SAT", text="SAT", style=shape.labeldown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)
bgcolor(preparation and not inTrade ? color.new(color.yellow, 92) : na, title="Hazirlik alani")

alertcondition(prepSignal, title="SPEK RADAR HAZIRLIK", message="SPEK RADAR HAZIRLIK | {{ticker}} | {{interval}} | {{close}}")
alertcondition(buySignal, title="SPEK RADAR AL", message="SPEK RADAR AL | {{ticker}} | {{interval}} | {{close}}")
alertcondition(sellSignal, title="SPEK RADAR SAT", message="SPEK RADAR SAT | {{ticker}} | {{interval}} | {{close}}")
